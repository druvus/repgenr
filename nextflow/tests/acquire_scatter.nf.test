nextflow_pipeline {

    name "ACQUIRE -> DEREPLICATE_SCATTER (stub)"
    script "../tests/acquire_scatter.nf"
    tag "stub"
    options "-stub"

    test("the genome channel from ACQUIRE feeds the scatter-gather dereplication") {
        when {
            params {
                derep_process_size = 1   // force several chunks from the stub genomes
                derep_tool = 'sourmash'
            }
        }
        then {
            assert workflow.success
            // METADATA + GENOME + one DEREP_CHUNK per genome (process size 1,
            // 2 non-outgroup genomes in the stub selection) + DEREP_MERGE
            def names = workflow.trace.succeeded().collect { it.name }
            assert names.any { it.contains('METADATA') }
            assert names.any { it.contains('GENOME') }
            assert names.count { it.contains('DEREP_CHUNK') } == 2
            assert names.any { it.contains('DEREP_MERGE') }
            assert workflow.trace.failed().size() == 0
        }
    }
}
