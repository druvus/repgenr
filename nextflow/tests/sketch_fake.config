// Test-only: SKETCH runs its real script with the fake sourmash of
// tests/fakebin (params.fakebin, set by the test), and user arguments that
// carry quotes.
process {
    withName: 'SKETCH' {
        beforeScript = { "export PATH=\"${params.fakebin}:\$PATH\"" }
        ext.args = "--license 'CC0'"
    }
}
